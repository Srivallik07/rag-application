{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "uv pip install --system -r requirements-vercel.txt -r requirements-vercel-build.txt",
  "buildCommand": "python3 scripts/build_vercel_corpus.py",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "vercel_data/corpus.json",
      "excludeFiles": "{.venv/**,src/**,tests/**,logs/**,storage/**,data/**,.pytest_cache/**,**/__pycache__/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
